<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="SCSCompanion.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SCSCompanion"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            <!-- Shared Fluent resources -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="StantonRed">#FF535C</Color>
            <Color x:Key="StantonBlue">#299BFF</Color>
            <Color x:Key="StantonPurple">#9D75FF</Color>
            <Color x:Key="StantonCyan">#42D6DC</Color>

            <SolidColorBrush x:Key="StantonRedBrush" Color="{StaticResource StantonRed}" />
            <SolidColorBrush x:Key="StantonBlueBrush" Color="{StaticResource StantonBlue}" />
            <SolidColorBrush x:Key="StantonPurpleBrush" Color="{StaticResource StantonPurple}" />
            <SolidColorBrush x:Key="StantonCyanBrush" Color="{StaticResource StantonCyan}" />
            <SolidColorBrush x:Key="DeviceWindowBrush" Color="#FF090B0E" />
            <SolidColorBrush x:Key="DeviceFaceBrush" Color="#FF101216" />
            <SolidColorBrush x:Key="DeviceTitleBrush" Color="#FF181A1E" />
            <SolidColorBrush x:Key="DeviceSurfaceBrush" Color="#FF05070A" />
            <SolidColorBrush x:Key="DeviceBorderBrush" Color="#FF535A64" />

            <Style x:Key="ModeButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="3,1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
